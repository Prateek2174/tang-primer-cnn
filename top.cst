//Physical Constraints file
//Part Number: GW2A-LV18PG256C8/I7
//Device: GW2A-18
//
// Pin locations sourced from sipeed/TangPrimer-20K-example on GitHub:
//   - CMOS block: verbatim match between Cam2HDMI and Cam2lcd examples
//     (two independent projects agree -- high confidence these are fixed
//     by the Dock PCB routing)
//   - UART block: from UART/UART_HELLO example
//   - clk/rst_n: Cam2HDMI and UART_HELLO examples disagree on both the
//     voltage for clk (2.5V vs 3.3V) and the physical pin for rst_n
//     (T10 vs T5). Went with Cam2HDMI's values (2.5V / T10) since it's
//     the closer match to this project (also uses the camera). If clk
//     fails to meet timing or Gowin flags a bank conflict, re-check
//     against the Dock schematic (Tang_Primer_20K_Dock-3713 or -3714,
//     whichever board you actually have) before assuming these are wrong.
//
// NOT YET FILLED IN -- confirm before synthesizing:
//   - led_1 / led_2 pin locations (no confirmed source found yet)
//   - btn pin location, if you add one
//   - PLL clkout wiring (Gowin_PLL instance in top.v currently only
//     drives cam_clk from clkout0 -- unused outputs clkout1-4)

//========================================================
// SYSTEM CLOCK / RESET
//========================================================

IO_LOC  "clk"    H11;
IO_PORT "clk"    IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;

// T10 is the physical reset button trace on the Primer 20K -- its
// dedicated function is SSPI (Slave SPI), separate from the MSPI
// function used for external-flash auto-boot. Enable "release SSPI
// pins for regular IO" in Project -> Configuration -> Dual-Purpose Pin
// before this will place successfully.
IO_LOC  "rst_n"  T10;
IO_PORT "rst_n"  IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//========================================================
// OV5640 DVP camera -- Tang Primer 20K Dock
//========================================================

// SCCB config bus (I2C-like) -- driven by i2c_bitbang_cam.v
IO_LOC  "cam_scl"   F14;
IO_PORT "cam_scl"   IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;
IO_LOC  "cam_sda"   F16;
IO_PORT "cam_sda"   IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;

// Camera -> FPGA sync + pixel clock (inputs)
IO_LOC  "cam_vsync" G15;
IO_PORT "cam_vsync" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_href"  G14;
IO_PORT "cam_href"  IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_pclk"  F13;
IO_PORT "cam_pclk"  IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;

// FPGA -> camera master clock (~24MHz, generated via PLL)
IO_LOC  "cam_xclk"  G12;
IO_PORT "cam_xclk"  IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;

// Control (outputs)
IO_LOC  "cam_rst_n" L13;
IO_PORT "cam_rst_n" IO_TYPE=LVCMOS25 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=2.5;
// Same SSPI dual-purpose-pin situation as rst_n above -- requires the
// same "release SSPI pins" Configuration setting to place successfully.
IO_LOC  "cam_pwdn"  C10;
IO_PORT "cam_pwdn"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 8-bit pixel data bus (inputs)
IO_LOC  "cam_data[0]" T12;
IO_PORT "cam_data[0]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[1]" T11;
IO_PORT "cam_data[1]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[2]" P11;
IO_PORT "cam_data[2]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[3]" R11;
IO_PORT "cam_data[3]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[4]" M15;
IO_PORT "cam_data[4]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[5]" M14;
IO_PORT "cam_data[5]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[6]" J16;
IO_PORT "cam_data[6]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;
IO_LOC  "cam_data[7]" J14;
IO_PORT "cam_data[7]" IO_TYPE=LVCMOS25 PULL_MODE=NONE BANK_VCCIO=2.5;

//========================================================
// UART TX -- from sipeed UART_HELLO example
//========================================================

// NOTE: M11 lands in Bank 2 per Gowin's own synthesis error (contradicts
// the UG110 pinout spreadsheet, which said Bank 4 -- trusting the tool
// here). Bank 2 is locked to 2.5V by the cross-validated camera block,
// so uart_tx_pin must match that voltage rather than the 3.3V the
// UART_HELLO example used (that example didn't share a bank with any
// camera pins, so its 3.3V choice doesn't carry over here).
// CAVEAT: most USB-UART adapters expect 3.3V/5V logic on RX. 2.5V TX
// often still registers correctly, but if you get no/garbled data on
// the PC side after confirming baud rate is correct, this voltage
// mismatch is the likely cause -- pick a genuinely different pin via
// Gowin's floorplanner/pin assignment view instead.
IO_LOC  "uart_tx_pin" M11;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS25 PULL_MODE=UP DRIVE=8 BANK_VCCIO=2.5;

//========================================================
// DEBUG LED -- confirmed C13 = LED0 (Orange_LED0 in the Dock-3713
// schematic). C13 is the dedicated DONE pin -- enable "Use DONE as
// regular IO" in Project -> Configuration -> Dual-Purpose Pin before
// this will place successfully (same fix pattern as SSPI for rst_n).
// Tied directly to cam_vsync in top.v to test whether the camera is
// producing any sync signal at all, independent of the UART chain.
//========================================================

IO_LOC  "led_0" C13;
IO_PORT "led_0" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// A13 = Orange_LED1 in the Dock-3713 schematic. A13 is the dedicated
// READY pin -- enable "Use READY as regular IO" in Configuration ->
// Dual-Purpose Pin before this will place successfully. Tied to
// cam_pclk to check whether the camera's pixel clock is genuinely
// toggling (dim/half-bright LED) vs stuck (solid bright or dark).
IO_LOC  "led_1" A13;
IO_PORT "led_1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
